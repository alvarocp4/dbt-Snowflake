038cbd-81cb-4745-8792-3687cba6a3ea\", \"name\": \"fact_mktv_visitas\", \"schema\": \"SH_MAIN\", \"status\": \"skipped\", \"execution_time\": 0, \"full_refresh\": false, \"materialization\": \"table\", \"compiled_code\": null, \"generated_at\": \"2026-06-04 13:14:44\"}, {\"unique_id\": \"model.dbt_mktv_project.yukon_int_closed\", \"invocation_id\": \"0f68e2b3-3383-4fbd-bd33-4c07e0769a44\", \"name\": \"yukon_int_closed\", \"schema\": \"SH_STAGING\", \"status\": \"success\", \"execution_time\": 0.8, \"full_refresh\": false, \"materialization\": \"view\", \"compiled_code\": \"SELECT\\n    TO_NUMBER(NUMBER_INTEGRATION_ID) AS NUMBER_INTEGRATION_ID,\\n    OPPORTUNITY_NUMBER,\\n    EVENT_DATETIME,\\n    PARSE_JSON(OWNERSHIP):\\\"costCenter\\\"::VARCHAR  AS COST_CENTER,\\n    PARSE_JSON(OWNERSHIP):\\\"ownerUserId\\\"::VARCHAR AS USER_ID,\\n    STATUS_NAME                                  AS STATUS,\\n    CHANGE_REASON                                AS CLOSING_REASON,\\n    CHANGE_TYPE                                  AS CLOSING_TYPE,\\n    EVENT_DATETIME                               AS CLOSING_DATE,\\n    ZIP_CODE,\\n    SEGMENT,\\n    SEGMENT_SUBTYPE\\nFROM DB_MINERVA.SH_STAGING.YUKON_OPPORTUNITY_CLOSED_ES\\nWHERE NUMBER_INTEGRATION_ID IS NOT NULL\\nQUALIFY ROW_NUMBER() OVER (\\n    PARTITION BY NUMBER_INTEGRATION_ID\\n    ORDER BY EVENT_DATETIME DESC\\n) = 1\\nORDER BY NUMBER_INTEGRATION_ID DESC\", \"generated_at\": \"2026-06-04 13:15:36\"}, {\"unique_id\": \"model.dbt_mktv_project.fact_mktv_visitas_trans\", \"invocation_id\": \"0f68e2b3-3383-4fbd-bd33-4c07e0769a44\", \"name\": \"fact_mktv_visitas_trans\", \"schema\": \"SH_MAIN\", \"status\": \"success\", \"execution_time\": 6.8, \"full_refresh\": false, \"materialization\": \"incremental\", \"compiled_code\": \"\\n\\nWITH\\nBASE AS (\\n\\n    SELECT\\n        COALESCE(BOOKED.NUMBER_INTEGRATION_ID, CREATED.NUMBER_INTEGRATION_ID) AS ID_PROSPECTO,\\n\\n        COALESCE(\\n            IFF(INSTALLED.NUMBER_INTEGRATION_ID IS NOT NULL, 'INSTALLED', NULL),\\n            IFF(OFFERSENT.NUMBER_INTEGRATION_ID IS NOT NULL, 'OFFERSENT', NULL),\\n            IFF(CLOSED.NUMBER_INTEGRATION_ID IS NOT NULL, 'CLOSED', NULL),\\n            IFF(ASSIGNED.NUMBER_INTEGRATION_ID IS NOT NULL, 'ASSIGNED', NULL),\\n            IFF(BOOKED.NUMBER_INTEGRATION_ID IS NOT NULL, 'BOOKED', NULL),\\n            IFF(UPDATED.NUMBER_INTEGRATION_ID IS NOT NULL, 'UPDATED', 'CREATED')\\n        ) AS PROSPECT_STATUS,\\n\\n        CREATED.FEC_CREACION_PROSPECTO,\\n\\n        /* \\u2705 NUEVA L\\u00d3GICA: capturamos el \\u00faltimo cambio REAL */\\n        GREATEST(\\n            COALESCE(CREATED.CREATION_DATETIME,      '1900-01-01'::TIMESTAMP),\\n            COALESCE(BOOKED.CREATION_DATETIME,       '1900-01-01'::TIMESTAMP),\\n            COALESCE(CLOSED.EVENT_DATETIME,          '1900-01-01'::TIMESTAMP),\\n            COALESCE(ASSIGNED.EVENT_DATETIME,        '1900-01-01'::TIMESTAMP),\\n            COALESCE(INSTALLED.EVENT_DATETIME,       '1900-01-01'::TIMESTAMP),\\n            COALESCE(OFFERSENT.EVENT_DATETIME,       '1900-01-01'::TIMESTAMP),\\n            COALESCE(UPDATED.EVENT_DATETIME,         '1900-01-01'::TIMESTAMP)\\n        ) AS SSFULTMODIFICA,\\n\\n        CURRENT_TIMESTAMP AS LOAD_DATE,\\n        CREATED.EVENT_DATETIME AS STATUS_DATE,\\n        CREATED.OPPORTUNITY_NUMBER\\n\\n    FROM DB_MARKETING.SH_STAGING.yukon_int_created CREATED\\n\\n    LEFT JOIN DB_MARKETING.SH_STAGING.yukon_int_booked BOOKED\\n        ON CREATED.NUMBER_INTEGRATION_ID = BOOKED.NUMBER_INTEGRATION_ID\\n\\n    LEFT JOIN DB_MARKETING.SH_STAGING.yukon_int_assigned ASSIGNED\\n        ON CREATED.NUMBER_INTEGRATION_ID = ASSIGNED.NUMBER_INTEGRATION_ID\\n\\n    LEFT JOIN DB_MARKETING.SH_STAGING.yukon_int_installed INSTALLED\\n        ON CREATED.NUMBER_INTEGRATION_ID = INSTALLED.NUMBER_INTEGRATION_ID\\n\\n    LEFT JOIN DB_MARKETING.SH_STAGING.yukon_int_closed CLOSED\\n        ON CREATED.NUMBER_INTEGRATION_ID = CLOSED.NUMBER_INTEGRATION_ID\\n\\n    LEFT JOIN DB_MARKETING.SH_STAGING.yukon_int_updated UPDATED\\n        ON CREATED.NUMBER_INTEGRATION_ID = UPDATED.NUMBER_INTEGRATION_ID\\n\\n    LEFT JOIN DB_MARKETING.SH_STAGING.yukon_int_offersent OFFERSENT\\n        ON CREATED.NUMBER_INTEGRATION_ID = OFFERSENT.NUMBER_INTEGRATION_ID\\n\\n\\n    \\n\\n    /* \\u2705 NUEVO FILTRO: detecta cambios en CUALQUIER estado */\\n    WHERE GREATEST(\\n        COALESCE(CREATED.CREATION_DATETIME,      '1900-01-01'::TIMESTAMP),\\n        COALESCE(BOOKED.CREATION_DATETIME,       '1900-01-01'::TIMESTAMP),\\n        COALESCE(CLOSED.EVENT_DATETIME,          '1900-01-01'::TIMESTAMP),\\n        COALESCE(ASSIGNED.EVENT_DATETIME,        '1900-01-01'::TIMESTAMP),\\n        COALESCE(INSTALLED.EVENT_DATETIME,       '1900-01-01'::TIMESTAMP),\\n        COALESCE(OFFERSENT.EVENT_DATETIME,       '1900-01-01'::TIMESTAMP),\\n        COALESCE(UPDATED.EVENT_DATETIME,         '1900-01-01'::TIMESTAMP)\\n    ) >= (SELECT MAX(SSFULTMODIFICA) FROM DB_MARKETING.SH_MAIN.fact_mktv_visitas_trans)\\n\\n    \\n),\\n\\nRANKED AS (\\n\\n    SELECT *,\\n        ROW_NUMBER() OVER (\\n            PARTITION BY ID_PROSPECTO\\n            ORDER BY\\n                SSFULTMODIFICA DESC,\\n                CASE PROSPECT_STATUS\\n                    WHEN 'INSTALLED' THEN 6\\n                    WHEN 'BOOKED'    THEN 5\\n                    WHEN 'CLOSED'    THEN 4\\n                    WHEN 'ASSIGNED'  THEN 3\\n                    WHEN 'UPDATED'   THEN 2\\n                    WHEN 'CREATED'   THEN 1\\n                    ELSE 0\\n                END DESC,\\n                LOAD_DATE DESC\\n        ) AS RN\\n    FROM BASE\\n)\\n\\nSELECT *\\nFROM RANKED\\nQUALIFY RN = 1\\nORDER BY ID_PROSPECTO DESC\", \"generated_at\": \"2026-06-04 13:15:36\"}, {\"unique_id\": \"model.dbt_mktv_project.yukon_int_updated\", \"invocation_id\": \"0f68e2b3-3383-4fbd-bd33-4c07e0769a44\", \"name\": \"yukon_int_updated\", \"schema\": \"SH_STAGING\", \"status\": \"success\", \"execution_time\": 0.9, \"full_refresh\": false, \"materialization\": \"view\", \"compiled_code\": \"SELECT\\n    TO_NUMBER(NUMBER_INTEGRATION_ID) AS NUMBER_INTEGRATION_ID,\\n    EVENT_DATETIME,\\n    CONVERT_TIMEZONE('UTC', 'Europe/Madrid',\\n        TRY_TO_TIMESTAMP_LTZ(\\n            COALESCE(PARSE_JSON(LEADGEN_DATA):\\\"leadGenerationTimeStamp\\\"::STRING, ''),\\n            'YYYY-MM-DD\\\"T\\\"HH24:MI:SS\\\"Z\\\"'\\n        )\\n    )                                                           AS FEC_CREACION_PROSPECTO,\\n    PARSE_JSON(OWNERSHIP):\\\"costCenter\\\"::VARCHAR                 AS COST_CENTER_RAW,\\n    LAST_VALUE(\\n        CASE WHEN PARSE_JSON(OWNERSHIP):\\\"costCenter\\\"::VARCHAR NOT IN ('89', '892')\\n             THEN PARSE_JSON(OWNERSHIP):\\\"costCenter\\\"::VARCHAR\\n        END\\n    ) IGNORE NULLS\\n    OVER (\\n        PARTITION BY NUMBER_INTEGRATION_ID\\n        ORDER BY EVENT_DATETIME\\n        ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING\\n    )                                                           AS COST_CENTER_PREV,\\n    LAST_VALUE(\\n        CASE WHEN PARSE_JSON(OWNERSHIP):\\\"costCenter\\\"::VARCHAR NOT IN ('89')\\n             THEN PARSE_JSON(OWNERSHIP):\\\"costCenter\\\"::VARCHAR\\n        END\\n    ) IGNORE NULLS\\n    OVER (\\n        PARTITION BY NUMBER_INTEGRATION_ID\\n        ORDER BY EVENT_DATETIME\\n        ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING\\n    )                                                           AS COST_CENTER_PREV_KEEP892,\\n    STATUS_NAME                                                 AS STATUS\\nFROM DB_MINERVA.SH_STAGING.YUKON_OPPORTUNITY_UPDATED_ES\\nWHERE NUMBER_INTEGRATION_ID IS NOT NULL\\nQUALIFY ROW_NUMBER() OVER (\\n    PARTITION BY NUMBER_INTEGRATION_ID\\n    ORDER BY EVENT_DATETIME DESC\\n) = 1\\nORDER BY NUMBER_INTEGRATION_ID DESC\", \"generated_at\": \"2026-06-04 13:15:36\"}, {\"unique_id\": \"model.dbt_mktv_project.yukon_int_assigned\", \"invocation_id\": \"0f68e2b3-3383-4fbd-bd33-4c07e0769a44\", \"name\": \"yukon_int_assigned\", \"schema\": \"SH_STAGING\", \"status\": \"success\", \"execution_time\": 0.7, \"full_refresh\": false, \"materialization\": \"view\", \"compiled_code\": \"SELECT\\n    TO_NUMBER(NUMBER_INTEGRATION_ID) AS NUMBER_INTEGRATION_ID,\\n    OWNERSHIP_SUBCHANNEL,\\n    EVENT_DATETIME,\\n    PARSE_JSON(OWNERSHIP):\\\"costCenter\\\"::VARCHAR AS COST_CENTER,\\n    ASSSIGNED_USER,\\n    ALLOCATOR_USER,\\n    STATUS_NAME                                AS STATUS,\\n    SALES_BRANCH_INFO\\nFROM DB_MINERVA.SH_STAGING.YUKON_VISIT_ASSIGNED_ES\\nWHERE NUMBER_INTEGRATION_ID IS NOT NULL\\nQUALIFY ROW_NUMBER() OVER (\\n    PARTITION BY NUMBER_INTEGRATION_ID\\n    ORDER BY EVENT_DATETIME DESC\\n) = 1\\nORDER BY NUMBER_INTEGRATION_ID DESC\", \"generated_at\": \"2026-06-04 13:15:36\"}, {\"unique_id\": \"model.dbt_mktv_project.ts_visitas\", \"invocation_id\": \"0f68e2b3-3383-4fbd-bd33-4c07e0769a44\", \"name\": \"ts_visitas\", \"schema\": \"SH_MAIN\", \"status\": \"success\", \"execution_time\": 1.5, \"full_refresh\": false, \"materialization\": \"table\", \"compiled_code\": \"SELECT\\n    OPPORTUNITY_NUMBER,\\n    ID_PROSPECTO,\\n    SSFULTMODIFICA,\\n    FEC_CREACION_PROSPECTO,\\n    INSTALLATION_CODE,\\n    ACD_DESCRIPTION,\\n    IFF(PROSPECT_STATUS = 'CLOSED', CLOSING_REASON, PROSPECT_STATUS) AS PROSPECT_STATUS,\\n    COST_CENTER,\\n    ZIP_CODE,\\n    OWNERSHIP_CHANNEL,\\n    OWNERSHIP_SUBCHANNEL,\\n    SEGMENT,\\n    SEGMENT_SUBTYPE,\\n    END_CONSTRUCTION_DATE,\\n    USER_ID_VS,\\n    ASSSIGNED_USER,\\n    OPPORTUNITY_ID,\\n    UNIQUE_INTENDER_ID,\\n    STATUS_BOOKING,\\n    STATUS_CRM41,\\n    STATUS_DATE,\\n    LOAD_DATE\\nFROM DB_MARKETING.SH_MAIN.fact_mktv_visitas\\nWHERE OWNERSHIP_SUBCHANNEL = 'Telesales'\\nORDER BY ID_PROSPECTO DESC\", \"generated_at\": \"2026-06-04 13:15:36\"}, {\"unique_id\": \"model.dbt_mktv_project.yukon_int_offersent\", \"invocation_id\": \"0f68e2b3-3383-4fbd-bd33-4c07e0769a44\", \"name\": \"yukon_int_offersent\", \"schema\": \"SH_STAGING\", \"status\": \"success\", \"execution_time\": 0.6, \"full_refresh\": false, \"materialization\": \"view\", \"compiled_code\": \"SELECT\\n    TO_NUMBER(NUMBER_INTEGRATION_ID) AS NUMBER_INTEGRATION_ID,\\n    EVENT_DATETIME,\\n    STATUS_NAME                                  AS STATUS,\\n    PARSE_JSON(OWNERSHIP):\\\"costCenter\\\"::VARCHAR  AS COST_CENTER,\\n    PARSE_JSON(OWNERSHIP):\\\"ownerUserId\\\"::VARCHAR AS USER_ID\\nFROM DB_MINERVA.SH_STAGING.YUKON_OFFER_SENT_ES\\nWHERE NUMBER_INTEGRATION_ID IS NOT NULL\\nQUALIFY ROW_NUMBER() OVER (\\n    PARTITION BY NUMBER_INTEGRATION_ID\\n    ORDER BY EVENT_DATETIME DESC\\n) = 1\\nORDER BY NUMBER_INTEGRATION_ID DESC\", \"generated_at\": \"2026-06-04 13:15:36\"}, {\"unique_id\": \"model.dbt_mktv_project.yukon_int_created\", \"invocation_id\": \"0f68e2b3-3383-4fbd-bd33-4c07e0769a44\", \"name\": \"yukon_int_created\", \"schema\": \"SH_STAGING\", \"status\": \"success\", \"execution_time\": 0.6, \"full_refresh\": false, \"materialization\": \"view\", \"compiled_code\": \"SELECT\\n    TO_NUMBER(NUMBER_INTEGRATION_ID) AS NUMBER_INTEGRATION_ID,\\n    OPPORTUNITY_NUMBER,\\n    OWNERSHIP_CHANNEL,\\n    OWNERSHIP_SUBCHANNEL,\\n    ZIP_CODE,\\n    SEGMENT,\\n    SEGMENT_SUBTYPE,\\n    DATE(END_CONSTRUCTION_DATE)                                                     AS END_CONSTRUCTION_DATE,\\n    CREATION_DATETIME,\\n    OPPORTUNITY_ID,\\n    UNIQUE_INTENDER_ID,\\n    STATUS_NAME,\\n    ACD_DESCRIPTION,\\n    CONVERT_TIMEZONE('UTC', 'Europe/Madrid', LEAD_GENERATION_DATETIME)             AS FEC_CREACION_PROSPECTO,\\n    PARSE_JSON(OWNERSHIP):\\\"costCenter\\\"::VARCHAR                                     AS COST_CENTER,\\n    PARSE_JSON(OWNERSHIP):\\\"ownerUserId\\\"::VARCHAR                                    AS ASSSIGNED_USER,\\n    EVENT_DATETIME\\nFROM DB_MINERVA.SH_STAGING.YUKON_OPPORTUNITY_CREATED_ES\\nWHERE NUMBER_INTEGRATION_ID IS NOT NULL\\nQUALIFY ROW_NUMBER() OVER (\\n    PARTITION BY NUMBER_INTEGRATION_ID\\n    ORDER BY EVENT_DATETIME DESC\\n) = 1\\nORDER BY NUMBER_INTEGRATION_ID DESC\", \"generated_at\": \"2026-06-04 13:15:36\"}, {\"unique_id\": \"model.dbt_mktv_project.yukon_int_booked\", \"invocation_id\": \"0f68e2b3-3383-4fbd-bd33-4c07e0769a44\", \"name\": \"yukon_int_booked\", \"schema\": \"SH_STAGING\", \"status\": \"success\", \"execution_time\": 0.6, \"full_refresh\": false, \"materialization\": \"view\", \"compiled_code\": \"SELECT\\n    TO_NUMBER(NUMBER_INTEGRATION_ID) AS NUMBER_INTEGRATION_ID,\\n    CREATION_DATETIME,\\n    EVENT_DATETIME,\\n    OWNERSHIP_CHANNEL,\\n    OWNERSHIP_SUBCHANNEL,\\n    ZIP_CODE,\\n    SEGMENT,\\n    SEGMENT_SUBTYPE,\\n    CONVERT_TIMEZONE('UTC', 'Europe/Madrid', VISIT_APPOINTMENT_DATE) AS VISIT_APPOINTMENT_DATE,\\n    DATE(END_CONSTRUCTION_DATE)                                       AS END_CONSTRUCTION_DATE,\\n    BOOKER_USER,\\n    OWNERSHIP,\\n    OPPORTUNITY_ID,\\n    OPPORTUNITY_NUMBER,\\n    UNIQUE_INTENDER_ID,\\n    STATUS_NAME\\nFROM DB_MINERVA.SH_STAGING.YUKON_VISIT_BOOKED_ES\\nQUALIFY ROW_NUMBER() OVER (\\n    PARTITION BY NUMBER_INTEGRATION_ID\\n    ORDER BY EVENT_DATETIME DESC\\n) = 1\\nORDER BY NUMBER_INTEGRATION_ID DESC\", \"generated_at\": \"2026-06-04 13:15:36\"}, {\"unique_id\": \"model.dbt_mktv_project.tb_visitas\", \"invocation_id\": \"0f68e2b3-3383-4fbd-bd33-4c07e0769a44\", \"name\": \"tb_visitas\", \"schema\": \"SH_MAIN\", \"status\": \"success\", \"execution_time\": 1.7, \"full_refresh\": false, \"materialization\": \"table\", \"compiled_code\": \"SELECT\\n    ID_PROSPECTO,\\n    PROSPECT_STATUS,\\n    OPPORTUNITY_NUMBER,\\n    FEC_CREACION_PROSPECTO,\\n    SSFULTMODIFICA,\\n    OWNERSHIP_CHANNEL,\\n    OWNERSHIP_SUBCHANNEL,\\n    ZIP_CODE,\\n    SEGMENT,\\n    SEGMENT_SUBTYPE,\\n    VISIT_APPOINTMENT_DATE,\\n    END_CONSTRUCTION_DATE,\\n    USER_ID_VS,\\n    ASSSIGNED_USER,\\n    ALLOCATOR_USER,\\n    COST_CENTER,\\n    OPPORTUNITY_ID,\\n    UNIQUE_INTENDER_ID,\\n    STATUS_BOOKING,\\n    STATUS_CRM41,\\n    INSTALLATION_CODE,\\n    LOAD_DATE\\nFROM DB_MARKETING.SH_MAIN.fact_mktv_visitas\\nWHERE OWNERSHIP_SUBCHANNEL = 'Telebooking'\\n  AND UPPER(USER_ID_VS) NOT IN ('CAIXA')\\nORDER BY ID_PROSPECTO DESC\", \"generated_at\": \"2026-06-04 13:15:36\"}, {\"unique_id\": \"model.dbt_mktv_project.tc_visitas\", \"invocation_id\": \"0f68e2b3-3383-4fbd-bd33-4c07e0769a44\", \"name\": \"tc_visitas\", \"schema\": \"SH_MAIN\", \"status\": \"success\", \"execution_time\": 1.6, \"full_refresh\": false, \"materialization\": \"table\", \"compiled_code\": \"SELECT\\n    ID_PROSPECTO,\\n    INSTALLATION_CODE,\\n    PROSPECT_STATUS,\\n    OPPORTUNITY_NUMBER,\\n    FEC_CREACION_PROSPECTO,\\n    SSFULTMODIFICA,\\n    OWNERSHIP_CHANNEL,\\n    OWNERSHIP_SUBCHANNEL,\\n    ZIP_CODE,\\n    SEGMENT,\\n    SEGMENT_SUBTYPE,\\n    VISIT_APPOINTMENT_DATE,\\n    END_CONSTRUCTION_DATE,\\n    USER_ID_VS,\\n    ASSSIGNED_USER,\\n    ALLOCATOR_USER,\\n    COST_CENTER,\\n    OPPORTUNITY_ID,\\n    UNIQUE_INTENDER_ID,\\n    STATUS_BOOKING,\\n    STATUS_CRM41,\\n    STATUS_DATE,\\n    LOAD_DATE\\nFROM DB_MARKETING.SH_MAIN.fact_mktv_visitas\\nWHERE (ASSSIGNED_USER LIKE 'TLC%' OR ASSSIGNED_USER LIKE 'TELEC%')\\n  AND PROSPECT_STATUS = 'INSTALLED'\\nORDER BY ID_PROSPECTO DESC\", \"generated_at\": \"2026-06-04 13:15:36\"}, {\"unique_id\": \"model.dbt_mktv_project.yukon_int_installed\", \"invocation_id\": \"0f68e2b3-3383-4fbd-bd33-4c07e0769a44\", \"name\": \"yukon_int_installed\", \"schema\": \"SH_STAGING\", \"status\": \"success\", \"execution_time\": 0.8, \"full_refresh\": false, \"materialization\": \"view\", \"compiled_code\": \"SELECT\\n    TO_NUMBER(NUMBER_INTEGRATION_ID) AS NUMBER_INTEGRATION_ID,\\n    EVENT_DATETIME,\\n    PARSE_JSON(OWNERSHIP):\\\"costCenter\\\"::VARCHAR  AS COST_CENTER,\\n    PARSE_JSON(OWNERSHIP):\\\"ownerUserId\\\"::VARCHAR AS USER_ID,\\n    STATUS_NAME                                  AS STATUS,\\n    INSTALLATION_CODE,\\n    INSTALLATION_DATE,\\n    ZIP_CODE,\\n    SEGMENT,\\n    SEGMENT_SUBTYPE\\nFROM DB_MINERVA.SH_STAGING.YUKON_OPPORTUNITY_INSTALLED_ES\\nWHERE NUMBER_INTEGRATION_ID IS NOT NULL\\nQUALIFY ROW_NUMBER() OVER (\\n    PARTITION BY NUMBER_INTEGRATION_ID\\n    ORDER BY EVENT_DATETIME DESC\\n) = 1\\nORDER BY NUMBER_INTEGRATION_ID DESC\", \"generated_at\": \"2026-06-04 13:15:36\"}, {\"unique_id\": \"model.dbt_mktv_project.fact_mktv_visitas\", \"invocation_id\": \"0f68e2b3-3383-4fbd-bd33-4c07e0769a44\", \"name\": \"fact_mktv_visitas\", \"schema\": \"SH_MAIN\", \"status\": \"success\", \"execution_time\": 3.5, \"full_refresh\": false, \"materialization\": \"table\", \"compiled_code\": \"WITH\\n\\nCLOSED_DUE_TO_OPP AS (\\n    SELECT DISTINCT\\n        CREATED.NUMBER_INTEGRATION_ID\\n    FROM DB_MINERVA.SH_STAGING.YUKON_OPPORTUNITY_CLOSED_ES AS CLOSED\\n    INNER JOIN DB_MINERVA.SH_STAGING.YUKON_OPPORTUNITY_CREATED_ES AS CREATED\\n        ON CLOSED.OPPORTUNITY_NUMBER = CREATED.OPPORTUNITY_NUMBER\\n    WHERE CLOSED.CHANGE_REASON LIKE '%Due to Opp%'\\n      AND CLOSED.NUMBER_INTEGRATION_ID IS NULL\\n      AND CREATED.NUMBER_INTEGRATION_ID IS NOT NULL\\n),\\n\\nTLVANU_PROSPECTOS AS (\\n    SELECT DISTINCT NUMBER_INTEGRATION_ID\\n    FROM DB_MINERVA.SH_STAGING.YUKON_OPPORTUNITY_CREATED_ES\\n    WHERE NUMBER_INTEGRATION_ID IS NOT NULL\\n      AND UPPER(PARSE_JSON(OWNERSHIP):\\\"ownerUserId\\\"::VARCHAR) = 'TLVANU'\\n\\n    UNION\\n\\n    SELECT DISTINCT NUMBER_INTEGRATION_ID\\n    FROM DB_MINERVA.SH_STAGING.YUKON_OFFER_SENT_ES\\n    WHERE NUMBER_INTEGRATION_ID IS NOT NULL\\n      AND UPPER(PARSE_JSON(OWNERSHIP):\\\"ownerUserId\\\"::VARCHAR) = 'TLVANU'\\n),\\n\\nFINAL AS (\\n    SELECT\\n        COALESCE(BOOKED.NUMBER_INTEGRATION_ID, CREATED.NUMBER_INTEGRATION_ID) AS ID_PROSPECTO,\\n        COALESCE(\\n            IFF(INSTALLED.NUMBER_INTEGRATION_ID IS NOT NULL, 'INSTALLED', NULL),\\n            IFF(OFFERSENT.NUMBER_INTEGRATION_ID IS NOT NULL, 'OFFERSENT', NULL),\\n            IFF(CLOSED.NUMBER_INTEGRATION_ID IS NOT NULL, 'CLOSED', NULL),\\n            IFF(ASSIGNED.NUMBER_INTEGRATION_ID IS NOT NULL, 'ASSIGNED', NULL),\\n            IFF(BOOKED.NUMBER_INTEGRATION_ID IS NOT NULL, 'BOOKED', NULL),\\n            IFF(UPDATED.NUMBER_INTEGRATION_ID IS NOT NULL, 'UPDATED', 'CREATED')\\n        )                                                                       AS PROSPECT_STATUS,\\n        CREATED.FEC_CREACION_PROSPECTO,\\n        COALESCE(BOOKED.CREATION_DATETIME, CREATED.CREATION_DATETIME)          AS SSFULTMODIFICA,\\n        COALESCE(BOOKED.OWNERSHIP_CHANNEL, CREATED.OWNERSHIP_CHANNEL)          AS OWNERSHIP_CHANNEL,\\n        COALESCE(CREATED.OWNERSHIP_SUBCHANNEL, BOOKED.OWNERSHIP_SUBCHANNEL)    AS OWNERSHIP_SUBCHANNEL,\\n        COALESCE(BOOKED.ZIP_CODE, CREATED.ZIP_CODE)                            AS ZIP_CODE,\\n        COALESCE(BOOKED.SEGMENT, CREATED.SEGMENT)                              AS SEGMENT,\\n        COALESCE(BOOKED.SEGMENT_SUBTYPE, CREATED.SEGMENT_SUBTYPE)              AS SEGMENT_SUBTYPE,\\n        BOOKED.VISIT_APPOINTMENT_DATE,\\n        COALESCE(BOOKED.END_CONSTRUCTION_DATE, CREATED.END_CONSTRUCTION_DATE)  AS END_CONSTRUCTION_DATE,\\n        INSTALLED.INSTALLATION_CODE,\\n        INSTALLED.INSTALLATION_DATE,\\n        COALESCE(BOOKED.BOOKER_USER, INSTALLED.USER_ID, CLOSED.USER_ID)        AS USER_ID_VS,\\n        DUSERMNT.MATRICULA                                                     AS MATRICULA,\\n        DUSERMNT.USR_MATRICULA_RESPONSABLE                                     AS RESPONSIBLE_USER_ID,\\n        COALESCE(CREATED.ASSSIGNED_USER, ASSIGNED.ASSSIGNED_USER)              AS ASSSIGNED_USER,\\n        ASSIGNED.ALLOCATOR_USER,\\n        CASE\\n            WHEN COALESCE(ASSIGNED.COST_CENTER, UPDATED.COST_CENTER_RAW, CREATED.COST_CENTER) = '89'\\n                THEN UPDATED.COST_CENTER_PREV\\n            WHEN COALESCE(ASSIGNED.COST_CENTER, UPDATED.COST_CENTER_RAW, CREATED.COST_CENTER) = '892'\\n                AND (CLOSED_DUE_TO_OPP.NUMBER_INTEGRATION_ID IS NOT NULL\\n                     OR TLVANU_PROSPECTOS.NUMBER_INTEGRATION_ID IS NOT NULL)\\n                THEN UPDATED.COST_CENTER_PREV\\n            ELSE COALESCE(\\n                CASE WHEN OFFERSENT.COST_CENTER IN ('89','892') THEN NULL ELSE OFFERSENT.COST_CENTER END,\\n                IFF(UPDATED.COST_CENTER_RAW IN ('89','892'), UPDATED.COST_CENTER_PREV, UPDATED.COST_CENTER_RAW),\\n                INSTALLED.COST_CENTER,\\n                CLOSED.COST_CENTER,\\n                ASSIGNED.COST_CENTER,\\n                ASSIGNED.SALES_BRANCH_INFO,\\n                CREATED.COST_CENTER\\n            )\\n        END                                                                     AS COST_CENTER,\\n        COALESCE(BOOKED.OPPORTUNITY_ID, CREATED.OPPORTUNITY_ID)                AS OPPORTUNITY_ID,\\n        COALESCE(BOOKED.OPPORTUNITY_NUMBER, CREATED.OPPORTUNITY_NUMBER)        AS OPPORTUNITY_NUMBER,\\n        COALESCE(BOOKED.UNIQUE_INTENDER_ID, CREATED.UNIQUE_INTENDER_ID)        AS UNIQUE_INTENDER_ID,\\n        COALESCE(\\n            INSTALLED.STATUS,\\n            OFFERSENT.STATUS,\\n            CLOSED.STATUS,\\n            ASSIGNED.STATUS,\\n            BOOKED.STATUS_NAME,\\n            CREATED.STATUS_NAME\\n        )                                                                       AS STATUS_BOOKING,\\n        COALESCE(\\n            INSTALLED.INSTALLATION_DATE,\\n            CLOSED.CLOSING_DATE,\\n            ASSIGNED.EVENT_DATETIME,\\n            BOOKED.EVENT_DATETIME,\\n            CREATED.EVENT_DATETIME\\n        )                                                                       AS STATUS_DATE,\\n        CLOSED.CLOSING_REASON,\\n        CLOSED.CLOSING_TYPE,\\n        CREATED.ACD_DESCRIPTION,\\n        CASE\\n            WHEN STATUS_BOOKING = 'VISIT_BOOKED'   THEN 'VACEP'\\n            WHEN STATUS_BOOKING = 'SALES_FEEDBACK' THEN 'No Terminado'\\n            WHEN STATUS_BOOKING = 'VISIT_ASSIGNED' THEN 'VASIG'\\n            WHEN STATUS_BOOKING = 'INSTALLED'      THEN 'TERM-Instalada'\\n            WHEN STATUS_BOOKING = 'CLOSED'         THEN CONCAT('Closed-', CLOSING_REASON)\\n        END                                                                     AS STATUS_CRM41,\\n        CURRENT_DATE()                                                          AS LOAD_DATE\\n    FROM DB_MARKETING.SH_STAGING.yukon_int_created   AS CREATED\\n    LEFT JOIN DB_MARKETING.SH_STAGING.yukon_int_booked   AS BOOKED\\n        ON CREATED.NUMBER_INTEGRATION_ID = BOOKED.NUMBER_INTEGRATION_ID\\n    LEFT JOIN DB_MARKETING.SH_STAGING.yukon_int_assigned AS ASSIGNED\\n        ON CREATED.NUMBER_INTEGRATION_ID = ASSIGNED.NUMBER_INTEGRATION_ID\\n    LEFT JOIN DB_MARKETING.SH_STAGING.yukon_int_installed AS INSTALLED\\n        ON CREATED.NUMBER_INTEGRATION_ID = INSTALLED.NUMBER_INTEGRATION_ID\\n    LEFT JOIN DB_MARKETING.SH_STAGING.yukon_int_closed   AS CLOSED\\n        ON CREATED.NUMBER_INTEGRATION_ID = CLOSED.NUMBER_INTEGRATION_ID\\n    LEFT JOIN DB_MARKETING.SH_STAGING.yukon_int_updated  AS UPDATED\\n        ON CREATED.NUMBER_INTEGRATION_ID = UPDATED.NUMBER_INTEGRATION_ID\\n    LEFT JOIN DB_MARKETING.SH_STAGING.yukon_int_offersent AS OFFERSENT\\n        ON CREATED.NUMBER_INTEGRATION_ID = OFFERSENT.NUMBER_INTEGRATION_ID\\n    LEFT JOIN CLOSED_DUE_TO_OPP\\n        ON CREATED.NUMBER_INTEGRATION_ID = CLOSED_DUE_TO_OPP.NUMBER_INTEGRATION_ID\\n    LEFT JOIN TLVANU_PROSPECTOS\\n        ON CREATED.NUMBER_INTEGRATION_ID = TLVANU_PROSPECTOS.NUMBER_INTEGRATION_ID\\n    LEFT JOIN DB_ODIN.SH_MAIN.D_USER_MNT AS DUSERMNT\\n        ON USER_ID_VS = DUSERMNT.MATRICULA\\n)\\n\\nSELECT DISTINCT * FROM FINAL\\nWHERE FEC_CREACION_PROSPECTO IS NOT NULL\\nORDER BY ID_PROSPECTO DESC\", \"generated_at\": \"2026-06-04 13:15:36\"}]--ELEMENTARY-MACRO-OUTPUT-END--"}, "info": {"category": "", "code": "I062", "extra": {}, "invocation_id": "f8a81b75-dfdf-4aa5-b87f-f27255319aed", "level": "info", "msg": "Elementary: --ELEMENTARY-MACRO-OUTPUT-START--[{\"unique_id\": \"model.dbt_mktv_project.yukon_int_closed\", \"invoca