SED.NUMBER_INTEGRATION_ID IS NOT NULL, 'CLOSED', NULL),\\n            IFF(ASSIGNED.NUMBER_INTEGRATION_ID IS NOT NULL, 'ASSIGNED', NULL),\\n            IFF(BOOKED.NUMBER_INTEGRATION_ID IS NOT NULL, 'BOOKED', NULL),\\n            IFF(UPDATED.NUMBER_INTEGRATION_ID IS NOT NULL, 'UPDATED', 'CREATED')\\n        ) AS PROSPECT_STATUS,\\n\\n        CREATED.FEC_CREACION_PROSPECTO,\\n\\n        /* \\u2705 NUEVA L\\u00d3GICA: capturamos el \\u00faltimo cambio REAL */\\n        GREATEST(\\n            COALESCE(CREATED.CREATION_DATETIME,      '1900-01-01'::TIMESTAMP),\\n            COALESCE(BOOKED.CREATION_DATETIME,       '1900-01-01'::TIMESTAMP),\\n            COALESCE(CLOSED.EVENT_DATETIME,          '1900-01-01'::TIMESTAMP),\\n            COALESCE(ASSIGNED.EVENT_DATETIME,        '1900-01-01'::TIMESTAMP),\\n            COALESCE(INSTALLED.EVENT_DATETIME,       '1900-01-01'::TIMESTAMP),\\n            COALESCE(OFFERSENT.EVENT_DATETIME,       '1900-01-01'::TIMESTAMP),\\n            COALESCE(UPDATED.EVENT_DATETIME,         '1900-01-01'::TIMESTAMP)\\n        ) AS SSFULTMODIFICA,\\n\\n        CURRENT_TIMESTAMP AS LOAD_DATE,\\n        CREATED.EVENT_DATETIME AS STATUS_DATE,\\n        CREATED.OPPORTUNITY_NUMBER\\n\\n    FROM DB_MARKETING.SH_STAGING.yukon_int_created CREATED\\n\\n    LEFT JOIN DB_MARKETING.SH_STAGING.yukon_int_booked BOOKED\\n        ON CREATED.NUMBER_INTEGRATION_ID = BOOKED.NUMBER_INTEGRATION_ID\\n\\n    LEFT JOIN DB_MARKETING.SH_STAGING.yukon_int_assigned ASSIGNED\\n        ON CREATED.NUMBER_INTEGRATION_ID = ASSIGNED.NUMBER_INTEGRATION_ID\\n\\n    LEFT JOIN DB_MARKETING.SH_STAGING.yukon_int_installed INSTALLED\\n        ON CREATED.NUMBER_INTEGRATION_ID = INSTALLED.NUMBER_INTEGRATION_ID\\n\\n    LEFT JOIN DB_MARKETING.SH_STAGING.yukon_int_closed CLOSED\\n        ON CREATED.NUMBER_INTEGRATION_ID = CLOSED.NUMBER_INTEGRATION_ID\\n\\n    LEFT JOIN DB_MARKETING.SH_STAGING.yukon_int_updated UPDATED\\n        ON CREATED.NUMBER_INTEGRATION_ID = UPDATED.NUMBER_INTEGRATION_ID\\n\\n    LEFT JOIN DB_MARKETING.SH_STAGING.yukon_int_offersent OFFERSENT\\n        ON CREATED.NUMBER_INTEGRATION_ID = OFFERSENT.NUMBER_INTEGRATION_ID\\n\\n\\n    \\n\\n    /* \\u2705 NUEVO FILTRO: detecta cambios en CUALQUIER estado */\\n    WHERE GREATEST(\\n        COALESCE(CREATED.CREATION_DATETIME,      '1900-01-01'::TIMESTAMP),\\n        COALESCE(BOOKED.CREATION_DATETIME,       '1900-01-01'::TIMESTAMP),\\n        COALESCE(CLOSED.EVENT_DATETIME,          '1900-01-01'::TIMESTAMP),\\n        COALESCE(ASSIGNED.EVENT_DATETIME,        '1900-01-01'::TIMESTAMP),\\n        COALESCE(INSTALLED.EVENT_DATETIME,       '1900-01-01'::TIMESTAMP),\\n        COALESCE(OFFERSENT.EVENT_DATETIME,       '1900-01-01'::TIMESTAMP),\\n        COALESCE(UPDATED.EVENT_DATETIME,         '1900-01-01'::TIMESTAMP)\\n    ) >= (SELECT MAX(SSFULTMODIFICA) FROM DB_MARKETING.SH_MAIN.fact_mktv_visitas_trans)\\n\\n    \\n),\\n\\nRANKED AS (\\n\\n    SELECT *,\\n        ROW_NUMBER() OVER (\\n            PARTITION BY ID_PROSPECTO\\n            ORDER BY\\n                SSFULTMODIFICA DESC,\\n                CASE PROSPECT_STATUS\\n                    WHEN 'INSTALLED' THEN 6\\n                    WHEN 'BOOKED'    THEN 5\\n                    WHEN 'CLOSED'    THEN 4\\n                    WHEN 'ASSIGNED'  THEN 3\\n                    WHEN 'UPDATED'   THEN 2\\n                    WHEN 'CREATED'   THEN 1\\n                    ELSE 0\\n                END DESC,\\n                LOAD_DATE DESC\\n        ) AS RN\\n    FROM BASE\\n)\\n\\nSELECT *\\nFROM RANKED\\nQUALIFY RN = 1\\nORDER BY ID_PROSPECTO DESC\", \"generated_at\": \"2026-06-04 13:15:36\"}, {\"unique_id\": \"model.dbt_mktv_project.yukon_int_updated\", \"invocation_id\": \"0f68e2b3-3383-4fbd-bd33-4c07e0769a44\", \"name\": \"yukon_int_updated\", \"schema\": \"SH_STAGING\", \"status\": \"success\", \"execution_time\": 0.9, \"full_refresh\": false, \"materialization\": \"view\", \"compiled_code\": \"SELECT\\n    TO_NUMBER(NUMBER_INTEGRATION_ID) AS NUMBER_INTEGRATION_ID,\\n    EVENT_DATETIME,\\n    CONVERT_TIMEZONE('UTC', 'Europe/Madrid',\\n        TRY_TO_TIMESTAMP_LTZ(\\n            COALESCE(PARSE_JSON(LEADGEN_DATA):\\\"leadGenerationTimeStamp\\\"::STRING, ''),\\n            'YYYY-MM-DD\\\"T\\\"HH24:MI:SS\\\"Z\\\"'\\n        )\\n    )                                                           AS FEC_CREACION_PROSPECTO,\\n    PARSE_JSON(OWNERSHIP):\\\"costCenter\\\"::VARCHAR                 AS COST_CENTER_RAW,\\n    LAST_VALUE(\\n        CASE WHEN PARSE_JSON(OWNERSHIP):\\\"costCenter\\\"::VARCHAR NOT IN ('89', '892')\\n             THEN PARSE_JSON(OWNERSHIP):\\\"costCenter\\\"::VARCHAR\\n        END\\n    ) IGNORE NULLS\\n    OVER (\\n        PARTITION BY NUMBER_INTEGRATION_ID\\n        ORDER BY EVENT_DATETIME\\n        ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING\\n    )                                                           AS COST_CENTER_PREV,\\n    LAST_VALUE(\\n        CASE WHEN PARSE_JSON(OWNERSHIP):\\\"costCenter\\\"::VARCHAR NOT IN ('89')\\n             THEN PARSE_JSON(OWNERSHIP):\\\"costCenter\\\"::VARCHAR\\n        END\\n    ) IGNORE NULLS\\n    OVER (\\n        PARTITION BY NUMBER_INTEGRATION_ID\\n        ORDER BY EVENT_DATETIME\\n        ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING\\n    )                                                           AS COST_CENTER_PREV_KEEP892,\\n    STATUS_NAME                                                 AS STATUS\\nFROM DB_MINERVA.SH_STAGING.YUKON_OPPORTUNITY_UPDATED_ES\\nWHERE NUMBER_INTEGRATION_ID IS NOT NULL\\nQUALIFY ROW_NUMBER() OVER (\\n    PARTITION BY NUMBER_INTEGRATION_ID\\n    ORDER BY EVENT_DATETIME DESC\\n) = 1\\nORDER BY NUMBER_INTEGRATION_ID DESC\", \"generated_at\": \"2026-06-04 13:15:36\"}, {\"unique_id\": \"model.dbt_mktv_project.yukon_int_assigned\", \"invocation_id\": \"0f68e2b3-3383-4fbd-bd33-4c07e0769a44\", \"name\": \"yukon_int_assigned\", \"schema\": \"SH_STAGING\", \"status\": \"success\", \"execution_time\": 0.7, \"full_refresh\": false, \