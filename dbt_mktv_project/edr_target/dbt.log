R(USER_ID_VS) NOT IN ('CAIXA')\\nORDER BY ID_PROSPECTO DESC\", \"generated_at\": \"2026-06-04 13:15:36\"}, {\"unique_id\": \"model.dbt_mktv_project.tc_visitas\", \"invocation_id\": \"0f68e2b3-3383-4fbd-bd33-4c07e0769a44\", \"name\": \"tc_visitas\", \"schema\": \"SH_MAIN\", \"status\": \"success\", \"execution_time\": 1.6, \"full_refresh\": false, \"materialization\": \"table\", \"compiled_code\": \"SELECT\\n    ID_PROSPECTO,\\n    INSTALLATION_CODE,\\n    PROSPECT_STATUS,\\n    OPPORTUNITY_NUMBER,\\n    FEC_CREACION_PROSPECTO,\\n    SSFULTMODIFICA,\\n    OWNERSHIP_CHANNEL,\\n    OWNERSHIP_SUBCHANNEL,\\n    ZIP_CODE,\\n    SEGMENT,\\n    SEGMENT_SUBTYPE,\\n    VISIT_APPOINTMENT_DATE,\\n    END_CONSTRUCTION_DATE,\\n    USER_ID_VS,\\n    ASSSIGNED_USER,\\n    ALLOCATOR_USER,\\n    COST_CENTER,\\n    OPPORTUNITY_ID,\\n    UNIQUE_INTENDER_ID,\\n    STATUS_BOOKING,\\n    STATUS_CRM41,\\n    STATUS_DATE,\\n    LOAD_DATE\\nFROM DB_MARKETING.SH_MAIN.fact_mktv_visitas\\nWHERE (ASSSIGNED_USER LIKE 'TLC%' OR ASSSIGNED_USER LIKE 'TELEC%')\\n  AND PROSPECT_STATUS = 'INSTALLED'\\nORDER BY ID_PROSPECTO DESC\", \"generated_at\": \"2026-06-04 13:15:36\"}, {\"unique_id\": \"model.dbt_mktv_project.yukon_int_installed\", \"invocation_id\": \"0f68e2b3-3383-4fbd-bd33-4c07e0769a44\", \"name\": \"yukon_int_installed\", \"schema\": \"SH_STAGING\", \"status\": \"success\", \"execution_time\": 0.8, \"full_refresh\": false, \"materialization\": \"view\", \"compiled_code\": \"SELECT\\n    TO_NUMBER(NUMBER_INTEGRATION_ID) AS NUMBER_INTEGRATION_ID,\\n    EVENT_DATETIME,\\n    PARSE_JSON(OWNERSHIP):\\\"costCenter\\\"::VARCHAR  AS COST_CENTER,\\n    PARSE_JSON(OWNERSHIP):\\\"ownerUserId\\\"::VARCHAR AS USER_ID,\\n    STATUS_NAME                                  AS STATUS,\\n    INSTALLATION_CODE,\\n    INSTALLATION_DATE,\\n    ZIP_CODE,\\n    SEGMENT,\\n    SEGMENT_SUBTYPE\\nFROM DB_MINERVA.SH_STAGING.YUKON_OPPORTUNITY_INSTALLED_ES\\nWHERE NUMBER_INTEGRATION_ID IS NOT NULL\\nQUALIFY ROW_NUMBER() OVER (\\n    PARTITION BY NUMBER_INTEGRATION_ID\\n    ORDER BY EVENT_DATETIME DESC\\n) = 1\\nORDER BY NUMBER_INTEGRATION_ID DESC\", \"generated_at\": \"2026-06-04 13:15:36\"}, {\"unique_id\": \"model.dbt_mktv_project.fact_mktv_visitas\", \"invocation_id\": \"0f68e2b3-3383-4fbd-bd33-4c07e0769a44\", \"name\": \"fact_mktv_visitas\", \"schema\": \"SH_MAIN\", \"status\": \"success\", \"execution_time\": 3.5, \"full_refresh\": false, \"materialization\": \"table\", \"compiled_code\": \"WITH\\n\\nCLOSED_DUE_TO_OPP AS (\\n    SELECT DISTINCT\\n        CREATED.NUMBER_INTEGRATION_ID\\n    FROM DB_MINERVA.SH_STAGING.YUKON_OPPORTUNITY_CLOSED_ES AS CLOSED\\n    INNER JOIN DB_MINERVA.SH_STAGING.YUKON_OPPORTUNITY_CREATED_ES AS CREATED\\n        ON CLOSED.OPPORTUNITY_NUMBER = CREATED.OPPORTUNITY_NUMBER\\n    WHERE CLOSED.CHANGE_REASON LIKE '%Due to Opp%'\\n      AND CLOSED.NUMBER_INTEGRATION_ID IS NULL\\n      AND CREATED.NUMBER_INTEGRATION_ID IS NOT NULL\\n),\\n\\nTLVANU_PROSPECTOS AS (\\n    SELECT DISTINCT NUMBER_INTEGRATION_ID\\n    FROM DB_MINERVA.SH_STAGING.YUKON_OPPORTUNITY_CREATED_ES\\n    WHERE NUMBER_INTEGRATION_ID IS NOT NULL\\n      AND UPPER(PARSE_JSON(OWNERSHIP):\\\"ownerUserId\\\"::VARCHAR) = 'TLVANU'\\n\\n    UNION\\n\\n    SELECT DISTINCT NUMBER_INTEGRATION_ID\\n    FROM DB_MINERVA.SH_STAGING.YUKON_OFFER_SENT_ES\\n    WHERE NUMBER_INTEGRATION_ID IS NOT NULL\\n      AND UPPER(PARSE_JSON(OWNERSHIP):\\\"ownerUserId\\\"::VARCHAR) = 'TLVANU'\\n),\\n\\nFINAL AS (\\n    SELECT\\n        COALESCE(BOOKED.NUMBER_INTEGRATION_ID, CREATED.NUMBER_INTEGRATION_ID) AS ID_PROSPECTO,\\n        COALESCE(\\n            IFF(INSTALLED.NUMBER_INTEGRATION_ID IS NOT NULL, 'INSTALLED', NULL),\\n            IFF(OFFERSENT.NUMBER_INTEGRATION_ID IS NOT NULL, 'OFFERSENT', NULL),\\n            IFF(CLOSED.NUMBER_INTEGRATION_ID IS NOT NULL, 'CLOSED', NULL),\\n            IFF(ASSIGNED.NUMBER_INTEGRATION_ID IS NOT NULL, 'ASSIGNED', NULL),\\n            IFF(BOOKED.NUMBER_INTEGRATION_ID IS NOT NULL, 'BOOKED', NULL),\\n            IFF(UPDATED.NUMBER_INTEGRATION_ID IS NOT NULL, 'UPDATED', 'CREATED')\\n        )                                                                       AS PROSPECT_STATUS,\\n        CREATED.FEC_CREACION_PROSPECTO,\\n        COALESCE(BOOKED.CREATION_DATETIME, CREATED.CREATION_DATETIME)          AS SSFULTMODIFICA,\\n        COALESCE(BOOKED.OWNERSHIP_CHANNEL, CREATED.OWNERSHIP_CHANNEL)          AS OWNERSHIP_CHANNEL,\\n        COALESCE(CREATED.OWNERSHIP_SUBCHANNEL, BOOKED.OWNERSHIP_SUBCHANNEL)    AS OWNERSHIP_SUBCHANNEL,\\n        COALESCE(BOOKED.ZIP_CODE, CREATED.ZIP_CODE)                            AS ZIP_CODE,\\n        COALESCE(BOOKED.SEGMENT, CREATED.SEGMENT)                              AS SEGMENT,\\n        COALESCE(BOOKED.SEGMENT_SUBTYPE, CREATED.SEGMENT_SUBTYPE)              AS SEGMENT_SUBTYPE,\\n        BOOKED.VISIT_APPOINTMENT_DATE,\\n        COALESCE(BOOKED.END_CONSTRUCTION_DATE, CREATED.END_CONSTRUCTION_DATE)  AS END_CONSTRUCTION_DATE,\\n        INSTALLED.INSTALLATION_CODE,\\n        INSTALLED.INSTALLATION_DATE,\\n        COALESCE(BOOKED.BOOKER_USER, INSTALLED.USER_ID, CLOSED.USER_ID)        AS USER_ID_VS,\\n        DUSERMNT.MATRICULA                                                     AS MATRICULA,\\n        DUSERMNT.USR_MATRICULA_RESPONSABLE                                     AS RESPONSIBLE_USER_ID,\\n        COALESCE(CREATED.ASSSIGNED_USER, ASSIGNED.ASSSIGNED_USER)              AS ASSSIGNED_USER,\\n        ASSIGNED.ALLOCATOR_USER,\\n        CASE\\n            WHEN COALESCE(ASSIGNED.COST_CENTER, UPDATED.COST_CENTER_RAW, CREATED.COST_CENTER) = '89'\\n                THEN UPDATED.COST_CENTER_PREV\\n            WHEN COALESCE(ASSIGNED.COST_CENTER, UPDATED.COST_CENTER_RAW, CREATED.COST_CENTER) = '892'\\n                AND (CLOSED_DUE_TO_OPP.NUMBER_INTEGRATION_ID IS NOT NULL\\n                     OR TLVANU_PROSPECTOS.NUMBER_INTEGRATION_ID IS NOT NULL)\\n                THEN UPDATED.COST_CENTER_PREV\\n            ELSE COALESCE(\\n                CASE WHEN OFFERSENT.COST_CENTER IN ('89','892') THEN NULL ELSE OFFERSENT.COST_CENTER END,\\n                IFF(UPDATED.COST_CENTER_RAW IN ('89','892'), UPDATED.COST_CENTER_PREV, UPDATED.COST_CENTER_RAW),\\n                INSTALLED.COST_CENTER,\\n                CLOSED.COST_CENTER,\\n                ASSIGNED.COST_CENTER,\\n                ASSIGNED.SALES_BRANCH_INFO,\\n                CREATED.COST_CENTER\\n            )\\n        END                                                                     AS COST_CENTER,\\n        COALESCE(BOOKED.OPPORTUNITY_ID, CREATED.OPPORTUNITY_ID)                AS OPPORTUNITY_ID,\\n        COALESCE(BOOKED.OPPORTUNITY_NUMBER, CREATED.OPPORTUNITY_NUMBER)        AS OPPORTUNITY_NUMBER,\\n        COALESCE(BOOKED.UNIQUE_INTENDER_ID, CREATED.UNIQUE_INTENDER_ID)        AS UNIQUE_INTENDER_ID,\\n        COALESCE(\\n            INSTALLED.STATUS,\\n            OFFERSENT.STATUS,\\n            CLOSED.STATUS,\\n            ASSIGNED.STATUS,\\n            BOOKED.STATUS_NAME,\\n            CREATED.STATUS_NAME\\n        )                                                                       AS STATUS_BOOKING,\\n        COALESCE(\\n            INSTALLED.INSTALLATION_DATE,\\n            CLOSED.CLOSING_DATE,\\n            ASSIGNED.EVENT_DATETIME,\\n            BOOKED.EVENT_DATETIME,\\n            CREATED.EVENT_DATETIME\\n        )                                                                       AS STATUS_DATE,\\n        CLOSED.CLOSING_REASON,\\n        CLOSED.CLOSING_TYPE,\\n        CREATED.ACD_DESCRIPTION,\\n        CASE\\n            WHEN STATUS_BOOKING = 'VISIT_BOOKED'   THEN 'VACEP'\\n            WHEN STATUS_BOOKING = 'SALES_FEEDBACK' THEN 'No Terminado'\\n            WHEN STATUS_BOOKING = 'VISIT_ASSIGNED' THEN 'VASIG'\\n            WHEN STATUS_BOOKING = 'INSTALLED'      THEN 'TERM-Instalada'\\n            WHEN STATUS_BOOKING = 'CLOSED'         THEN CONCAT('Closed-', CLOSING_REASON)\\n        END                                                                     AS STATUS_CRM41,\\n        CURRENT_DATE()                                                          AS LOAD_DATE\\n    FROM DB_MARKETING.SH_STAGING.yukon_int_created   AS CREATED\\n    LEFT JOIN DB_MARKETING.SH_STAGING.yukon_int_booked   AS BOOKED\\n        ON CREATED.NUMBER_INTEGRATION_ID = BOOKED.NUMBER_INTEGRATION_ID\\n    LEFT JOIN DB_MARKETING.SH_STAGING.yukon_int_assigned AS ASSIGNED\\n        ON CREATED.NUMBER_INTEGRATION_ID = ASSIGNED.NUMBER_INTEGRATION_ID\\n    LEFT JOIN DB_MARKETING.SH_STAGING.yukon_int_installed AS INSTALLED\\n        ON CREATED.NUMBER_INTEGRATION_ID = INSTALLED.NUMBER_INTEGRATION_ID\\n    LEFT JOIN DB_MARKETING.SH_STAGING.yukon_int_closed   AS CLOSED\\n        ON CREATED.NUMBER_INTEGRATION_ID = CLOSED.NUMBER_INTEGRATION_ID\\n    LEFT JOIN DB_MARKETING.SH_STAGING.yukon_int_updated  AS UPDATED\\n        ON CREATED.NUMBER_INTEGRATION_ID = UPDATED.NUMBER_INTEGRATION_ID\\n    LEFT JOIN DB_MARKETING.SH_STAGING.yukon_int_offersent AS OFFERSENT\\n        ON CREATED.NUMBER_INTEGRATION_ID = OFFERSENT.NUMBER_INTEGRATION_ID\\n    LEFT JOIN CLOSED_DUE_TO_OPP\\n        ON CREATED.NUMBER_INTEGRATION_ID = CLOSED_DUE_TO_OPP.NUMBER_INTEGRATION_ID\\n    LEFT JOIN TLVANU_PROSPECTOS\\n        ON CREATED.NUMBER_INTEGRATION_ID = TLVANU_PROSPECTOS.NUMBER_INTEGRATION_ID\\n    LEFT JOIN DB_ODIN.SH_MAIN.D_USER_MNT AS DUSERMNT\\n        ON USER_ID_VS = DUSERMNT.MATRICULA\\n)\\n\\nSELECT DISTINCT * FROM FINAL\\nWHERE FEC_CREACION_PROSPECTO IS NOT NULL\\nORDER BY ID_PROSPECTO DESC\", \"generated_at\": \"2026-06-04 13:15:36\"}]--ELEMENTARY-MACRO-OUTPUT-END--", "name": "JinjaLogInfo", "pid": 17368, "thread": "MainThread", "ts": "2026-06-04T13:16:54.469234Z"}}
